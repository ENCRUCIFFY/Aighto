{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aighto",
  "version": "0.3.4",
  "identifier": "com.aighto.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Aighto",
        "width": 1120,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI4MDJDNEI4QjFDRDlBQTMKUldTam1zMnh1TVFDdUhzblNVYnVWUDV5eENmRUtwV2FzNjFSUVZLWS9uMG56WFF6dktXSHpQMmsK",
      "endpoints": [
        "https://wszyjsirtuwoxfqsrbiq.supabase.co/storage/v1/object/public/app-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
